# ── Supabase ───────────────────────────────────────────────
# Service-role key. SERVER ONLY. Never expose to a browser bundle.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Twilio ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The public origin Twilio calls. Used to rebuild the exact URL for
# signature validation — do NOT derive this from request headers, which
# are spoofable behind a proxy.
PUBLIC_BASE_URL=https://switchboard.example.com

# ── Safety ─────────────────────────────────────────────────
# When true, outbound SMS is recorded but never handed to Twilio.
# Leave true until A2P 10DLC registration clears. Per-client
# clients.sms_dry_run overrides this when it is set to false.
SMS_DRY_RUN=true

# Shared secret for the deferred-message drain route (Vercel Cron).
CRON_SECRET=
