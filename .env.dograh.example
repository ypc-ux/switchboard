# Dograh Voice Agent Configuration
# Self-hosted open-source voice agent for Switchboard
# Copy to .env.local and fill in your Dograh instance details

# Enable/disable Dograh voice agent
# Set to "true" to enable, "false" to disable
DOGRAH_ENABLED=false

# Dograh SIP Server Domain
# The hostname or IP of your Dograh SIP server
# Example: sip.dograh.local, 192.168.1.100, dograh.example.com
DOGRAH_SIP_DOMAIN=

# Dograh SIP Server Port
# Default SIP port is 5060
# Use 5061 for TLS, 5062 for custom port
# Optional: defaults to 5060
DOGRAH_SIP_PORT=5060

# Dograh Webhook Secret (optional)
# If your Dograh instance uses webhook authentication
# DOGRAH_WEBHOOK_SECRET=

# Dograh API Key (optional)
# If Dograh provides an API key for additional features
# DOGRAH_API_KEY=
